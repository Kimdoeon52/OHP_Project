  player: {fileID: 1958427976}
  steps:
  - hint: "60\uCD08. \uB358\uC804\uC5D0\uC11C \uB124\uAC8C \uC8FC\uC5B4\uC9C4 \uC2DC\uAC04\uC740
      \uADF8\uAC8C \uC804\uBD80\uB2E4.\n\u2026\uD558\uC9C0\uB9CC \uC5EC\uAE30 \uC138\uC774\uD504\uB8F8\uC5D0\uC120
      \uC2DC\uAC04\uC774 \uBA48\uCDB0 \uC788\uB2E4. \uCC9C\uCC9C\uD788 \uC775\uD600\uB77C.\n[\uC544\uBB34
      \uD0A4\uB098 \uB20C\uB7EC \uC2DC\uC791]"
    condition: 0
    region: {fileID: 0}
    killCount: 0
    freeLook: 0
    compactHint: 0
    openDoors: []
  - hint: "\uC9C0\uB3C4 \uC2A4\uD06C\uB864\uC744 \uD3BC\uCE58\uBA74 \uB358\uC804\uC758
      \uAD6C\uC870\uAC00 \uB4DC\uB7EC\uB09C\uB2E4. \uC0AC\uC6A9\uD574 \uBCF4\uC790.\n[
      \uC784\uC2DC: \uC544\uBB34 \uD0A4\uB098 \uB20C\uB7EC ]"
    condition: 0
    region: {fileID: 0}
    killCount: 0
    freeLook: 0
    compactHint: 0
    openDoors: []
  - hint: "\uC138\uC774\uD504\uB8F8\uC5D0\uC120 \uC2DC\uAC04\uC774 \uD750\uB974\uC9C0
      \uC54A\uB294\uB2E4 \u2014 \uC774\uACF3\uC740 \uACC4\uD68D\uD558\uB294 \uACF3\uC774\uB2E4.\n\uD720\uB85C
      \uD655\uB300/\uCD95\uC18C, \uB4DC\uB798\uADF8\uB85C \uB9F5\uC744 \uC0B4\uD53C\uBA70
      \uB3D9\uC120\uC744 \uBBF8\uB9AC \uC9DC\uB77C."
    condition: 2
    region: {fileID: 0}
    killCount: 0
    freeLook: 1
    compactHint: 0
    openDoors: []
  - hint: "E \uB97C \uB20C\uB7EC \uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4\uB77C.
      \uAC00\uC9C4 \uC544\uC774\uD15C\uC744 \uD655\uC778\uD558\uACE0 \uC4F8 \uC218
      \uC788\uB2E4."
    condition: 3
    region: {fileID: 0}
    killCount: 0
    freeLook: 0
    compactHint: 0
    openDoors: []
  - hint: "\uACC4\uD68D\uC740 \uB05D\uB0AC\uB2E4. \uC774\uC81C \uC2E4\uD589\uC774\uB2E4
      \u2014 \uBC1C\uC744 \uB4E4\uC774\uB294 \uC21C\uAC04 \uC2DC\uAC04\uC774 \uD750\uB978\uB2E4.\n\uC624\uB978\uCABD
      \uBAAC\uC2A4\uD130 \uBC29\uC73C\uB85C \uC774\uB3D9\uD558\uB77C."
    condition: 4
    region: {fileID: 17156091}
    killCount: 0
    freeLook: 0
    compactHint: 1
    openDoors: []
  - hint: "\uC801\uC744 \uCC98\uCE58\uD558\uACE0 \uC5F4\uC1E0\uB97C \uC190\uC5D0
      \uB123\uC5B4\uB77C. \uC7A0\uAE34 \uC0C1\uC790\uB97C \uC5F4\uB824\uBA74 \uD544\uC694\uD558\uB2E4."
    condition: 5
    region: {fileID: 0}
    killCount: 1
    freeLook: 0
    compactHint: 0
    openDoors: []
  - hint: "\uC774 \uBCBD\u2026 \uC5B4\uB518\uAC00 \uC774\uC0C1\uD558\uB2E4. \uC218\uC0C1\uD55C
      \uBCBD \uC55E\uC5D0\uC11C F \uB85C \uD0D0\uC0C9\uD574 \uC228\uACA8\uC9C4 \uBB38\uC744
      \uCC3E\uC544\uB77C."
    condition: 6
    region: {fileID: 0}
    killCount: 0
    freeLook: 0
    compactHint: 0
    openDoors: []
  - hint: "\uBB38\uC774 \uB4DC\uB7EC\uB0AC\uB2E4. \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uB77C."
    condition: 4
