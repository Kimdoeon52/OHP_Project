    killCount: 0
    freeLook: 0
    compactHint: 1
    openDoors: []
  - hint: "\uC5F4\uC1E0\uB85C \uC0C1\uC790\uB97C \uC5F4\uC5B4\uB77C. \uC7A0\uAE34
      \uC0C1\uC790\uC5D4 \uC544\uC774\uD15C\uC774 \uB4E4\uC5B4 \uC788\uB2E4."
    condition: 7
