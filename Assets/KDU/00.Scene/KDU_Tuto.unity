    killCount: 0
    freeLook: 0
    compactHint: 0
    openDoors: []
  - hint: "\uCD9C\uAD6C \uBC29\uC73C\uB85C \uD5A5\uD558\uB77C. \uD3EC\uD0C8\uC774
      \uB2E4\uC74C \uCE35\uC73C\uB85C \uC774\uC5B4\uC9C4\uB2E4."
    condition: 4
